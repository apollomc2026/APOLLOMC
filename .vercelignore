.next/
.next-*/
apps/portal/.next/
apps/portal/.next-*/
apps/portal/tmp/
tmp/
test-results/
apps/portal/test-results/
apps/portal/playwright-report/
apps/portal/pnpm-lock.yaml
apps/portal/pnpm-workspace.yaml
pnpm-lock.yaml
